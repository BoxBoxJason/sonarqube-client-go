{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":assignAndReview(BoxBoxJason)",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":docker",
    ":enableRenovate",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)",
    ":gitSignOff",
    ":gomod",
    ":ignoreModulesAndTests",
    ":labels(deps,source::bot)",
    ":rebaseStalePrs",
    ":renovatePrefix",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    ":semanticCommitType(chore)",
    "group:all",
    "helpers:githubDigestChangelogs",
    "helpers:gitlabDigestChangelogs",
    "helpers:goXPackagesNameLink",
    "helpers:renovateChangelog",
    "mergeConfidence:all-badges",
    "security:openssf-scorecard",
    "workarounds:all"
  ],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true
  },
  "updateInternalDeps": true,
  "dependencyDashboardAutoclose": true,
  "dependencyDashboardLabels": [
    "deps",
    "source::bot"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions pinned as `<name> := <value>` variables in the Makefile, annotated with a `# renovate: datasource=... depName=... [versioning=...]` comment (SonarQube Docker images, `go install` tool versions).",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "# renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*[A-Za-z0-9_]+\\s*:?=\\s*(?<currentValue>[^\\s#]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "The Makefile vars feed a local `docker`/`podman run` only, and the custom-manager regex captures no digest group, so a pinDigest update would rewrite the whole annotated line and break the Makefile. CI service images are still digest-pinned by the github-actions manager.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "Makefile"
      ],
      "pinDigests": false
    }
  ]
}
